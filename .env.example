# Copy this file to .env and fill in the values. Never commit .env.
# Two LLM providers are used (names are your choice; see docs/TRD.md section 8).

LLM_A_PROVIDER=
LLM_A_MODEL=
LLM_A_API_KEY=
LLM_A_BASE_URL=
LLM_A_DAILY_LIMIT=

LLM_B_PROVIDER=
LLM_B_MODEL=
LLM_B_API_KEY=
LLM_B_BASE_URL=
LLM_B_DAILY_LIMIT=

# Comments per LLM request in batch runs (inference.py always sends one)
LLM_BATCH_SIZE=20

# Optional: Hugging Face token for model downloads
HF_TOKEN=
