# Copy this file to .env and fill in the values. Never commit .env.
# Two LLM components (A and B), both through an OpenAI-compatible chat-completions endpoint (docs/TRD.md §10).
# PROVIDER is a free name used in cache file names (e.g. groq, openrouter, gemini).
# BASE_URL examples: https://api.groq.com/openai/v1 , https://openrouter.ai/api/v1 ,
#                    https://generativelanguage.googleapis.com/v1beta/openai
# DAILY_LIMIT = requests per day you allow the scripts to spend (budget guard); empty = no limit.
# EXTRA_BODY  = optional JSON merged into every request of that LLM, e.g. for reasoning models (Groq openai/gpt-oss-*):
#               {"reasoning_effort": "low"}   Leave empty otherwise.

LLM_A_PROVIDER=
LLM_A_MODEL=
LLM_A_API_KEY=
LLM_A_BASE_URL=
LLM_A_DAILY_LIMIT=
LLM_A_EXTRA_BODY=

LLM_B_PROVIDER=
LLM_B_MODEL=
LLM_B_API_KEY=
LLM_B_BASE_URL=
LLM_B_DAILY_LIMIT=
LLM_B_EXTRA_BODY=

# Comments per LLM request in batch runs (inference.py always sends one). Set it from the batch-size pilot:
#   python -m src.training.run_llm_batch --provider a --pilot
LLM_BATCH_SIZE=50

# Optional: Hugging Face token for model downloads
HF_TOKEN=
